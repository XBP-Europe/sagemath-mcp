# The passagemath image: the same server on the pip-installable SageMath fork.
#
# Why it exists: the monolithic sagemath/sagemath image is published for
# linux/amd64 only, so Apple-silicon and Graviton hosts run it under emulation.
# passagemath ships aarch64 wheels for every backend the tools need (GAP, PARI,
# Singular, Maxima/ECL, FLINT), so this image is built natively for linux/amd64
# and linux/arm64 by release.yml and published with a `-passagemath` tag suffix
# (ghcr.io/xbp-europe/sagemath-mcp:<tag>-passagemath). The pull is ~1 GB of
# wheels instead of a 3 GB image; on disk it is larger, not smaller (4.4 GB
# against 3.1 GB, measured 2026-09-14) -- the case for it is architecture, not
# size.
#
# It is the optional image. The monolithic one stays primary and is what the
# release is smoke-tested and signed against first; docs/passagemath_evaluation.md
# records why and when that changes. The security policy is identical on both:
# _artifacts.py selects the passagemath allowlist at import because
# passagemath-standard is installed, and the passagemath CI lane runs the whole
# suite against the exact pin below before it moves.

# --- build stage -------------------------------------------------------------
# Everything that matters arrives as a wheel, but not quite everything on every
# architecture: the first arm64 build failed because cysignals 1.12.6 shipped
# no aarch64 wheel and pip fell back to its sdist, which needs a C compiler.
# So the install runs in a stage that has one, into a venv the runtime stage
# copies -- the compiler never reaches the published image.
# Pinned by digest to the multi-arch index (amd64 + arm64 resolve from it);
# Dependabot refreshes it. The same digest is used for both stages below.
FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70 AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY pyproject.toml README.md LICENSE requirements-passagemath.txt ./
COPY src ./src

# Hash-checking install. requirements-passagemath.txt is exported from uv.lock
# (`make passagemath-lock`) with every wheel and sdist hash the lock knows, so
# pip installs exactly the locked set on either architecture and refuses
# anything else: a re-uploaded wheel, a substituted index, a resolution of its
# own. The pin itself still lives in pyproject's [passagemath] extra, moved only
# through the passagemath CI lane; tests/test_passagemath_lock.py fails when the
# export and the lock disagree. Two limits, stated rather than hidden: pip does
# not hash-check the *build* dependencies it fetches for an sdist fallback (the
# arm64 cysignals build), and the project itself is installed from the checkout
# with --no-deps, its dependencies already satisfied from the lock.
# pip is then removed from the venv: nothing installs at runtime, and the copy
# python -m venv seeds from the base image (25.0.1 in 0.9.6) carried a dozen
# advisories into the published image while never being run.
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --require-hashes -r requirements-passagemath.txt \
    && /opt/venv/bin/pip install --no-cache-dir --no-deps . \
    && /opt/venv/bin/python -m pip uninstall --yes pip

# --- runtime stage -----------------------------------------------------------
FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70

# The base image's own pip goes too, for the same reason as the venv's: the
# server runs from /opt/venv and never installs anything.
RUN python -m pip uninstall --yes pip

# Same UID/GID as the `sage` user in sagemath/sagemath:10.10, so the Compose
# file and the Helm chart (runAsUser/fsGroup 1001, tmpfs at /home/sage/.sage)
# apply unchanged to either image.
RUN groupadd --gid 1001 sage \
    && useradd --uid 1001 --gid 1001 --create-home --home-dir /home/sage \
       --shell /bin/bash sage

COPY --from=builder --chown=sage:sage /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /workspace
COPY --chown=sage:sage README.md LICENSE ./

USER sage
ENV HOME=/home/sage
# The hardened run has a read-only root filesystem with tmpfs only at /tmp and
# /home/sage/.sage; matplotlib's default config dir under ~/.config is neither.
ENV MPLCONFIGDIR=/tmp/matplotlib

# The official MCP registry proves this image belongs to the server it lists by
# reading this label; it must equal `name` in server.json.
LABEL io.modelcontextprotocol.server.name="io.github.XBP-Europe/sagemath-mcp"

EXPOSE 8314
# passagemath-environment ships the `sage` wrapper (it accepts -python), so the
# entrypoint and the worker's launch path are the same as in the monolithic
# image and nothing in the server knows which image it is in.
ENTRYPOINT ["sage", "-python", "-m", "sagemath_mcp.server"]
CMD ["--transport", "streamable-http", "--host", "0.0.0.0", "--port", "8314"]
