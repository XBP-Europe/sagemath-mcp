{
  "name": "sagemath-mcp",
  "displayName": "SageMath MCP",
  "version": "0.11.0",
  "description": "40 sandboxed SageMath tools for Claude: symbolic calculus, number theory, linear algebra, graphs, groups, elliptic curves, plotting and claim verification, with a persistent Sage session per conversation.",
  "author": {
    "name": "XBP Europe",
    "url": "https://github.com/XBP-Europe"
  },
  "homepage": "https://github.com/XBP-Europe/sagemath-mcp",
  "repository": "https://github.com/XBP-Europe/sagemath-mcp",
  "license": "MIT",
  "icon": "./assets/icon.png",
  "documentationUrl": "https://github.com/XBP-Europe/sagemath-mcp/blob/main/USAGE.md",
  "supportUrl": "https://github.com/XBP-Europe/sagemath-mcp/blob/main/SUPPORT.md",
  "privacyPolicyUrl": "https://github.com/XBP-Europe/sagemath-mcp/blob/main/PRIVACY.md",
  "keywords": [
    "sagemath",
    "mathematics",
    "computer-algebra",
    "symbolic",
    "number-theory"
  ],
  "mcpServers": {
    "sagemath": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "sagemath-mcp[passagemath]==0.11.0",
        "sagemath-mcp"
      ]
    }
  },
  "network": {
    "hosts": [
      "pypi.org",
      "files.pythonhosted.org",
      "releases.astral.sh"
    ]
  }
}
